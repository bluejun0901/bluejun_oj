POSTGRES_USER=oj_user
POSTGRES_PASSWORD=oj_password
POSTGRES_DB=oj_db
OJ_DB_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
OJ_DATA_DIR=/data
OJ_REDIS_URL=redis://redis:6379/0
OJ_SESSION_SECRET=development-session-secret-change-me
OJ_ADMIN_BOOTSTRAP_USERNAME=admin
OJ_ADMIN_BOOTSTRAP_PASSWORD=adminpassword
OJ_MEMORY_LIMIT_MB=1024
OJ_ISOLATE_CGROUP=auto
OJ_SESSION_MAX_AGE=604800 # 7 days in seconds
OJ_COOKIE_SECURE=false